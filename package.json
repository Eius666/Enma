{
  "name": "enma",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.7.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^13.5.0",
    "@ton/core": "^0.63.1",
    "@ton/crypto": "^3.3.0",
    "@tonconnect/ui-react": "^2.4.4",
    "@types/jest": "^27.5.2",
    "@types/node": "^16.18.126",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.17",
    "@vercel/kv": "^3.0.0",
    "date-fns": "^4.1.0",
    "firebase": "^12.1.0",
    "firebase-admin": "^13.0.2",
    "openai": "^6.43.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^4.12.0",
    "react-scripts": "5.0.1",
    "typescript": "^4.9.5",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "dev": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "test:unit": "node --test api/_lib/__tests__/insights.test.js api/_lib/finance/__tests__/normalizeCurrency.test.js api/_lib/finance/__tests__/resolveLegacyCurrency.test.js api/_lib/insights/__tests__/detectorsCurrency.test.js api/_lib/insights/__tests__/cashGapThreshold.test.js api/_lib/finance/__tests__/lockedAmount.test.js api/_lib/fx/__tests__/fx.test.js api/_lib/transactions/__tests__/financialTransaction.test.js api/_lib/insights/__tests__/proactiveRub.test.js",
    "test:rules": "firebase emulators:exec --only firestore --project enma-rules-test \"node --test firestore-tests/rules.test.js\"",
    "test:brain": "node api/_lib/evals/runner.js",
    "test:brain:finance": "node api/_lib/evals/runner.js --domain finance",
    "test:brain:proactive": "node api/_lib/evals/runner.js --domain proactive",
    "test:brain:critical": "node api/_lib/evals/runner.js --critical-only",
    "test:all": "npm run test:unit && npm run test:brain",
    "eval": "node api/_lib/evals/runner.js --json-output eval-report.json",
    "typecheck": "npx tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "eject": "react-scripts eject",
    "predeploy": "cross-env PUBLIC_URL=https://Eius666.github.io/Enma npm run build",
    "deploy": "gh-pages -d build"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "cross-env": "^7.0.3",
    "gh-pages": "^6.3.0"
  },
  "engines": {
    "node": "24.x"
  }
}
