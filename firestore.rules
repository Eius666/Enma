rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Auth strategy note
    // -------------------------------------------------------------------------
    // Enma uses Firebase Authentication (signInWithEmailAndPassword +
    // signInAnonymously).  All client-side Firestore reads/writes are therefore
    // protected by `request.auth.uid` matching the document's owner field.
    //
    // Server-side writes (api/ routes) go through the Firebase Admin SDK which
    // bypasses these rules entirely — security there is enforced in the route
    // code itself (see api/_lib/verifyWebhookSig.js, rateLimit.js).
    // -------------------------------------------------------------------------

    // Helper: is the caller authenticated?
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: does the caller own this document (by userId field)?
    function ownsDoc() {
      return isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Helper: does the incoming write claim the caller's own uid?
    function writesOwnUid() {
      return isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    // -------------------------------------------------------------------------
    // /users/{userId}
    // -------------------------------------------------------------------------
    // Stores the Firebase UID → Telegram chatId mapping written by App.tsx.
    match /users/{userId} {
      // Users may only read/write their own top-level user document.
      allow read, write: if isAuthenticated() && request.auth.uid == userId;

      // Sub-collections (workspaces, etc.) inherit the parent restriction.
      match /{subcollection}/{docId} {
        allow read, write: if isAuthenticated() && request.auth.uid == userId;
      }
    }

    // -------------------------------------------------------------------------
    // /transactions/{transactionId}
    // -------------------------------------------------------------------------
    // Flat collection; every document carries a userId field.
    match /transactions/{transactionId} {
      allow read:             if ownsDoc();
      allow create:           if writesOwnUid();
      allow update, delete:   if ownsDoc();
    }

    // -------------------------------------------------------------------------
    // /reminders/{reminderId}
    // -------------------------------------------------------------------------
    match /reminders/{reminderId} {
      allow read:             if ownsDoc();
      allow create:           if writesOwnUid();
      allow update, delete:   if ownsDoc();
    }

    // -------------------------------------------------------------------------
    // /categories/{categoryId}
    // -------------------------------------------------------------------------
    // Top-level categories collection referenced by lib/firestore.ts.
    match /categories/{categoryId} {
      allow read:             if ownsDoc();
      allow create:           if writesOwnUid();
      allow update, delete:   if ownsDoc();
    }

    // -------------------------------------------------------------------------
    // /telegramUsers/{docId}
    // -------------------------------------------------------------------------
    // Written by App.tsx (doc ID = "tg_{telegramUserId}") to record the link
    // between a Telegram user and their Firebase UID.
    // The document carries a firebaseUid field; we match that to the caller.
    match /telegramUsers/{docId} {
      allow read:   if isAuthenticated() && resource.data.firebaseUid == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.firebaseUid == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.firebaseUid == request.auth.uid
                                        && request.resource.data.firebaseUid == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.firebaseUid == request.auth.uid;
    }

    // -------------------------------------------------------------------------
    // /subscriptions/{userId}
    // -------------------------------------------------------------------------
    // Written exclusively by the server (Admin SDK) on payment confirmation.
    // Clients may only read their own subscription document.
    match /subscriptions/{userId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
    }

    // -------------------------------------------------------------------------
    // /payments/{paymentId}
    // -------------------------------------------------------------------------
    // Client may create a pending payment for themselves (no confirmedAt allowed).
    // Only the server (Admin SDK via api/ton/verify.js) writes status:'confirmed'.
    match /payments/{paymentId} {
      allow read: if ownsDoc();
      allow create: if writesOwnUid()
        && request.resource.data.status == 'pending'
        && !('confirmedAt' in request.resource.data);
    }

    // -------------------------------------------------------------------------
    // /notes/{noteId}
    // -------------------------------------------------------------------------
    match /notes/{noteId} {
      allow read:           if ownsDoc();
      allow create:         if writesOwnUid();
      allow update, delete: if ownsDoc();
    }

    // -------------------------------------------------------------------------
    // /habits/{habitId}
    // -------------------------------------------------------------------------
    // Flat collection; every document carries a userId field.
    match /habits/{habitId} {
      allow read:           if ownsDoc();
      allow create:         if writesOwnUid();
      allow update, delete: if ownsDoc();
    }

    // -------------------------------------------------------------------------
    // /tasks/{taskId}
    // -------------------------------------------------------------------------
    // Flat collection; every document carries a userId field.
    match /tasks/{taskId} {
      allow read:           if ownsDoc();
      allow create:         if writesOwnUid();
      allow update, delete: if ownsDoc();
    }

    // -------------------------------------------------------------------------
    // Catch-all deny
    // -------------------------------------------------------------------------
    // Any collection not explicitly listed above is denied to authenticated AND
    // unauthenticated callers.  This prevents accidentally exposing new
    // collections before rules are written for them.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
