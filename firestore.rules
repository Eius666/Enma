rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────────────────────
    // Auth strategy:
    //   Client writes → protected by these rules (request.auth.uid)
    //   Admin SDK writes (api/ routes) → bypass rules entirely
    // ─────────────────────────────────────────────────────────────────────────

    // ── Core helpers ─────────────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function ownsDoc() {
      return isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    function writesOwnUid() {
      return isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    // ── Date helpers ──────────────────────────────────────────────────────────
    // request.time is UTC — acceptable precision for server-side limit checks.

    function monthStr() {
      let m = request.time.month();
      return string(request.time.year()) + '-' +
        (m < 10 ? '0' + string(m) : string(m));
    }

    function dateStr() {
      let m = request.time.month();
      let d = request.time.day();
      return string(request.time.year()) + '-' +
        (m < 10 ? '0' + string(m) : string(m)) + '-' +
        (d < 10 ? '0' + string(d) : string(d));
    }

    // ── Subscription helpers ──────────────────────────────────────────────────
    // Reads subscriptions/{uid} — written exclusively by Admin SDK.
    // Each subscription document must include endDateMs (ms since epoch) so that
    // these rules can compare it to request.time.toMillis().
    //
    // Paid plan:  plan == 'pro' | 'premium', status == 'active', endDateMs > now
    // Trial:      plan == 'free', trialPlan == 'pro' | 'premium',
    //             status == 'active', trialEndDateMs > now

    function isActivePaidPlan(sub) {
      return sub.status == 'active' &&
        sub.get('endDateMs', 0) > request.time.toMillis() &&
        (sub.plan == 'pro' || sub.plan == 'premium');
    }

    function isActiveTrial(sub) {
      return sub.plan == 'free' &&
        sub.get('trialPlan', '') in ['pro', 'premium'] &&
        sub.get('trialEndDateMs', 0) > request.time.toMillis();
    }

    // Returns true when the user has any active paid plan or trial.
    // Costs at most 1 exists() + 1 get() per call.
    function hasPaidAccess(uid) {
      let subPath = /databases/$(database)/documents/subscriptions/$(uid);
      let hasSub  = exists(subPath);
      let sub     = hasSub ? get(subPath).data : {};
      return hasSub && (isActivePaidPlan(sub) || isActiveTrial(sub));
    }

    // ── Free-tier counter helpers ─────────────────────────────────────────────
    // freeUsage/{uid} — single flat document per user, updated atomically by the
    // client (usageCounters.ts). Fields:
    //   month            — "YYYY-MM" of the current transactionCount window
    //   transactionCount — monthly transaction count
    //   date             — "YYYY-MM-DD" of the current dailyTaskCount window
    //   dailyTaskCount   — daily task count
    //   habitCount       — cumulative habit count
    //   noteCount        — cumulative note count
    //   bankCount        — cumulative bank/wallet count
    //
    // Time-windowed fields reset automatically: if the stored month/date doesn't
    // match the current UTC month/date, the counter is treated as 0.

    function freeData(uid) {
      let path = /databases/$(database)/documents/users/$(uid)/freeUsage/counters;
      return exists(path) ? get(path).data : {};
    }

    function freeTxOk(uid) {
      let d = freeData(uid);
      // Allow if stored month is stale (new month) or count is under limit.
      return d.get('month', '') != monthStr() || d.get('transactionCount', 0) < 30;
    }

    function freeHabitOk(uid) {
      return freeData(uid).get('habitCount', 0) < 3;
    }

    function freeNoteOk(uid) {
      return freeData(uid).get('noteCount', 0) < 10;
    }

    function freeTaskOk(uid) {
      let d = freeData(uid);
      // Allow if stored date is stale (new day) or count is under limit.
      return d.get('date', '') != dateStr() || d.get('dailyTaskCount', 0) < 5;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // /users/{userId}
    // ─────────────────────────────────────────────────────────────────────────

    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;

      // AI chat history — written server-side by api/ai/[action].js (Admin SDK)
      match /aiChats/{docId} {
        allow read, write: if isAuthenticated() && request.auth.uid == userId;
      }

      // Free usage counters — written exclusively by Admin SDK (api/ai/freeIncrement).
      // Client writes are blocked so a user cannot zero their own counter directly.
      match /freeUsage/{docId} {
        allow read:  if isAuthenticated() && request.auth.uid == userId;
        allow write: if false;
      }

      // ── Workspace subcollections ─────────────────────────────────────────
      // users/{uid}/workspaces/{wid} — workspace document (no limit on creation)
      match /workspaces/{workspaceId} {
        allow read:           if isAuthenticated() && request.auth.uid == userId;
        allow create:         if isAuthenticated() && request.auth.uid == userId;
        allow update, delete: if isAuthenticated() && request.auth.uid == userId;

        // Transactions — 30/month for Free
        match /transactions/{txId} {
          allow read:           if isAuthenticated() && request.auth.uid == userId;
          allow create:         if isAuthenticated() && request.auth.uid == userId &&
                                   (hasPaidAccess(userId) || freeTxOk(userId));
          allow update, delete: if isAuthenticated() && request.auth.uid == userId;
        }

        // Habits — 3 total for Free
        match /habits/{habitId} {
          allow read:           if isAuthenticated() && request.auth.uid == userId;
          allow create:         if isAuthenticated() && request.auth.uid == userId &&
                                   (hasPaidAccess(userId) || freeHabitOk(userId));
          allow update, delete: if isAuthenticated() && request.auth.uid == userId;
        }

        // Notes — 10 total for Free
        match /notes/{noteId} {
          allow read:           if isAuthenticated() && request.auth.uid == userId;
          allow create:         if isAuthenticated() && request.auth.uid == userId &&
                                   (hasPaidAccess(userId) || freeNoteOk(userId));
          allow update, delete: if isAuthenticated() && request.auth.uid == userId;
        }

        // Goals — no Free limit
        match /goals/{goalId} {
          allow read, write: if isAuthenticated() && request.auth.uid == userId;
        }

        // Habit logs — no Free limit
        match /habitLogs/{logId} {
          allow read, write: if isAuthenticated() && request.auth.uid == userId;
        }
      }
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Flat top-level collections (main app write path)
    // userId is stored in each document and checked via ownsDoc() / writesOwnUid()
    // ─────────────────────────────────────────────────────────────────────────

    // Finance transactions — 30/month for Free
    match /transactions/{transactionId} {
      allow read:           if ownsDoc();
      allow create:         if writesOwnUid() &&
                               (hasPaidAccess(request.auth.uid) || freeTxOk(request.auth.uid));
      allow update, delete: if ownsDoc();
    }

    // Habits — 3 total for Free
    match /habits/{habitId} {
      allow read:           if ownsDoc();
      allow create:         if writesOwnUid() &&
                               (hasPaidAccess(request.auth.uid) || freeHabitOk(request.auth.uid));
      allow update, delete: if ownsDoc();
    }

    // Notes — 10 total for Free
    match /notes/{noteId} {
      allow read:           if ownsDoc();
      allow create:         if writesOwnUid() &&
                               (hasPaidAccess(request.auth.uid) || freeNoteOk(request.auth.uid));
      allow update, delete: if ownsDoc();
    }

    // Day-flow tasks — 5/day for Free
    match /tasks/{taskId} {
      allow read:           if ownsDoc();
      allow create:         if writesOwnUid() &&
                               (hasPaidAccess(request.auth.uid) || freeTaskOk(request.auth.uid));
      allow update, delete: if ownsDoc();
    }

    // ─────────────────────────────────────────────────────────────────────────
    // /aiUsage/{userId}
    // Written exclusively by Admin SDK (API serverless routes).
    // Clients can read their own usage to display progress bars; writes are blocked.
    // ─────────────────────────────────────────────────────────────────────────
    match /aiUsage/{userId} {
      allow read:  if isAuthenticated() && request.auth.uid == userId;
      allow write: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // /rateLimits/{docId}
    // docId format: "{userId}_{action}"
    // Client reads/writes only docs prefixed with their own uid.
    // ─────────────────────────────────────────────────────────────────────────
    match /rateLimits/{docId} {
      allow read:  if isAuthenticated() && docId.matches(request.auth.uid + '_.*');
      allow write: if isAuthenticated() &&
                      request.resource.data.get('userId', '') == request.auth.uid &&
                      docId.matches(request.auth.uid + '_.*');
    }

    // ─────────────────────────────────────────────────────────────────────────
    // /reminders/{reminderId}
    // ─────────────────────────────────────────────────────────────────────────
    match /reminders/{reminderId} {
      allow read:           if ownsDoc();
      allow create:         if writesOwnUid();
      allow update, delete: if ownsDoc();
    }

    // ─────────────────────────────────────────────────────────────────────────
    // /categories/{categoryId}
    // ─────────────────────────────────────────────────────────────────────────
    match /categories/{categoryId} {
      allow read:           if ownsDoc();
      allow create:         if writesOwnUid();
      allow update, delete: if ownsDoc();
    }

    // ─────────────────────────────────────────────────────────────────────────
    // /telegramUsers/{docId}
    // ─────────────────────────────────────────────────────────────────────────
    match /telegramUsers/{docId} {
      allow read:   if isAuthenticated() && resource.data.firebaseUid == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.firebaseUid == request.auth.uid;
      allow update: if isAuthenticated() &&
                       resource.data.firebaseUid == request.auth.uid &&
                       request.resource.data.firebaseUid == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.firebaseUid == request.auth.uid;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // /subscriptions/{userId}
    // Written exclusively by Admin SDK on payment confirmation.
    // Clients may only read their own subscription document.
    // ─────────────────────────────────────────────────────────────────────────
    match /subscriptions/{userId} {
      allow read:  if isAuthenticated() && request.auth.uid == userId;
      allow write: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // /payments/{paymentId}
    // Client creates a pending payment; server confirms it via Admin SDK.
    // ─────────────────────────────────────────────────────────────────────────
    match /payments/{paymentId} {
      allow read:   if ownsDoc();
      allow create: if writesOwnUid() &&
                       request.resource.data.status == 'pending' &&
                       !('confirmedAt' in request.resource.data);
    }

    // ─────────────────────────────────────────────────────────────────────────
    // /messages/{messageId}
    // Bot conversation history — written by Admin SDK via chatHistory.js.
    // ─────────────────────────────────────────────────────────────────────────
    match /messages/{messageId} {
      allow read:  if ownsDoc();
      allow write: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // /canonicalUids/{docId}
    // Written server-side by api/auth/telegram.js only.
    // ─────────────────────────────────────────────────────────────────────────
    match /canonicalUids/{docId} {
      allow read, write: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Catch-all deny — any collection not listed above is fully blocked.
    // ─────────────────────────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
