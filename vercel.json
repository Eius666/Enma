{
  "functions": {
    "api/telegram/webhook.js":      { "maxDuration": 30 },
    "api/telegram/cron.js":         { "maxDuration": 30 },
    "api/cron/content-plan.js":     { "maxDuration": 30 },
    "api/cron/content-publish.js":  { "maxDuration": 30 },
    "api/cron/maintenance.js":      { "maxDuration": 30 },
    "api/cron/insights.js":         { "maxDuration": 30 },
    "api/ai/[action].js":           { "maxDuration": 30 },
    "api/insights/[action].js":     { "maxDuration": 15 },
    "api/payment/[action].js":      { "maxDuration": 30 }
  },
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    },
    {
      "source": "/index.html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    },
    {
      "source": "/manifest.json",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    },
    {
      "source": "/asset-manifest.json",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    },
    {
      "source": "/static/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
