{
  "compilerOptions": {
    "target": "es2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "lib": ["es2020", "dom"]
  },
  "include": [
    "api/**/*.js"
  ],
  "exclude": [
    "node_modules",
    "build",
    "functions"
  ]
}
