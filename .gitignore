# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# production
/build

# generated at build time (scripts/generateBuildId.js) — never committed,
# fresh on every build, read at runtime by api/version.js
/api/_generated

# misc
.DS_Store
.env.local
.env.development.local
.env.test.local
.env.production.local

npm-debug.log*
yarn-debug.log*
yarn-error.log*
.vercel
.env*.local
.gh-pages-tmp/

# Firebase Functions (functions/) — track src/, package.json, package-lock.json
# and tsconfig.json so `firebase deploy --only functions` is reproducible from
# a clean clone; exclude only its own dependencies, build output, and secrets.
functions/node_modules/
functions/lib/
functions/.env
functions/.env.*

scripts/*.key
scripts/*.json
Снимок экрана*.png

# Firebase service-account keys — must never be committed
NEW_KEY_ENMA.json
enma-4ea29-firebase-adminsdk-fbsvc-32b4b33295.json
*firebase-adminsdk*.json
serviceAccountKey*.json

# R1: vendored/generated artifacts that must never be tracked
finance-bot/node_modules/
.firebase/
eval-report.json
enma-migration-kit.zip
package-lock 2.json
