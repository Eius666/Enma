# DEV environment (Vercel project `enma-l4lh`, id prj_wwGqJR959AHCKURTDE20rRXrsb2c) — variable NAMES; secrets left blank.
# Known non-secret DEV identifiers are filled in. Full matrix: docs/DEV_ENVIRONMENT.md
# Never copy a value from the production Vercel project into DEV.

# --- isolation switches (plain, build + runtime) ---
ENMA_ENV=dev
DEV_FIREBASE_PROJECT_ID=enmadev-aa7b1
DEV_TELEGRAM_BOT_ID=8952129105
DEV_VERCEL_PROJECT_ID=prj_wwGqJR959AHCKURTDE20rRXrsb2c   # enma-dev; guard requires VERCEL_PROJECT_ID to equal this
DEV_ALLOWED_CHAT_IDS=                # comma-separated Telegram ids of testers

# --- Telegram (server runtime) ---
TELEGRAM_BOT_TOKEN=                  # SECRET — DEV bot @Enmadevbot only, entered by the owner
TELEGRAM_BOT_USERNAME=Enmadevbot
TELEGRAM_WEBHOOK_SECRET=             # SECRET — openssl rand -hex 32, DEV only

# --- Firebase (server runtime) ---
FIREBASE_SERVICE_ACCOUNT=            # SECRET — DEV project service-account JSON (raw or base64)
FIREBASE_STORAGE_BUCKET=             # optional until file storage is used, e.g. enmadev-aa7b1.firebasestorage.app

# --- Firebase Web App (client, baked at BUILD; public values) ---
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=      # enmadev-aa7b1.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=enmadev-aa7b1
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=151104397988
REACT_APP_FIREBASE_APP_ID=1:151104397988:web:da6c2ee2ecc052f1d1fc31

# --- client app (build) ---
REACT_APP_URL=                       # temporary enma-dev URL, never enma.su / enma-silk
REACT_APP_BOT_USERNAME=Enmadevbot
# REACT_APP_TONCONNECT_MANIFEST=     # leave unset (falls back to the DEV origin); TON is disabled

# --- server secrets (runtime) ---
CRON_SECRET=                         # SECRET — required in DEV (cron routes are open if unset)
ADMIN_API_KEY=                       # SECRET
ADMIN_TELEGRAM_IDS=                  # testers only
PARTNER_SESSION_SECRET=              # SECRET
OPENROUTER_API_KEY=                  # SECRET, optional: without it AI is UNVERIFIED in DEV

# --- must NOT be set in DEV ---
#   PLATEGA_MERCHANT_ID PLATEGA_SECRET            (guard refuses; opt-in DEV_PLATEGA_SANDBOX=true)
#   TON_PAYMENT_WALLET TONCENTER_API_KEY          (guard refuses; opt-in DEV_TON_ENABLED=true)
#   THREADS_* TELEGRAM_CONTENT_CHANNEL_ID CONTENT_ADMIN_CHAT_ID  (posting to real channels/socials)
