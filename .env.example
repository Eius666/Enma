# ── Telegram ────────────────────────────────────────────────────────────────
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Registered via `node scripts/set-webhook.js` — passed as Telegram's secret_token.
# Must match what Vercel has set. Generate: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# When true, webhook saves transactions without asking the user to confirm.
TELEGRAM_AUTO_CONFIRM=false

# ── Firebase Admin SDK (serverless functions only) ───────────────────────────
# Raw JSON or base64-encoded JSON service account key.
# Encode with: node scripts/encode-key.js path/to/serviceAccount.json
FIREBASE_SERVICE_ACCOUNT=

# ── Auth for internal endpoints (/api/telegram/send, /api/telegram/cron) ────
# Both endpoints return 503 if this is unset (fail closed).
# Generate: openssl rand -hex 32
CRON_SECRET=

# ── Client-side Firebase (React app) ────────────────────────────────────────
# Values are in Firebase console → Project settings → Your apps → SDK setup
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=

# Set to true to enable client-side reminder polling (uses /api/telegram/send).
# Leave false on Vercel — the cron endpoint handles reminders server-side.
REACT_APP_CLIENT_REMINDERS=false
