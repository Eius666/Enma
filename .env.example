# =============================================================================
# Enma — environment variables reference
# Copy this file to .env.local (never commit .env.local to version control)
# =============================================================================

# -----------------------------------------------------------------------------
# Firebase — PUBLIC (safe to expose in client bundle)
# CRA requires the REACT_APP_ prefix for client-accessible vars.
# These replace the hardcoded values in src/src/firebase.ts — see src/config/env.ts
# -----------------------------------------------------------------------------
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=

# -----------------------------------------------------------------------------
# Feature flags
# -----------------------------------------------------------------------------
# Set to 'true' to enable client-side polling for reminder notifications.
# Only useful when the app is open in the browser; use the cron route otherwise.
REACT_APP_CLIENT_REMINDERS=false

# Optional public app URL (used in links)
REACT_APP_URL=https://enma.vercel.app

# -----------------------------------------------------------------------------
# Telegram — SECRET (server-side only, never expose in client bundle)
# -----------------------------------------------------------------------------

# Your Telegram Bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# -----------------------------------------------------------------------------
# OpenRouter — SECRET (server-side only)
# All AI calls go through OpenRouter (one key, multiple models).
# Get your key at https://openrouter.ai/keys
# -----------------------------------------------------------------------------

# Required: your OpenRouter API key
OPENROUTER_API_KEY=

# Optional: override default model IDs (defaults shown below)
# OPENROUTER_PRIMARY_MODEL=z-ai/glm-5.2
# OPENROUTER_FALLBACK_MODEL=anthropic/claude-sonnet-4
# OPENROUTER_LAST_RESORT_MODEL=google/gemini-2.5-flash

# -----------------------------------------------------------------------------
# Admin access — comma-separated Telegram user IDs that bypass subscription
# -----------------------------------------------------------------------------
# ADMIN_TELEGRAM_IDS=123456789,987654321

# Secret token set when registering the webhook:
#   setWebhook(url=..., secret_token=<this value>)
# Used to verify that incoming webhook POST requests are genuinely from Telegram.
# See api/_lib/verifyWebhookSig.js
TELEGRAM_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Content pipeline — SECRET (server-side only)
# -----------------------------------------------------------------------------

# Your personal Telegram chat ID for content moderation (get from @userinfobot).
# The bot sends post ideas and drafts here for your approval.
# Different from TELEGRAM_CONTENT_CHANNEL_ID (the public channel).
CONTENT_ADMIN_CHAT_ID=

# Telegram channel where posts are published. Format: @channelname or -100xxxxxxxxxx
TELEGRAM_CONTENT_CHANNEL_ID=

# Threads (Meta) — for cross-posting. Get long-lived token from Meta Developer Console.
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=

# -----------------------------------------------------------------------------
# Cron — SECRET (server-side only)
# -----------------------------------------------------------------------------

# Passed as "Authorization: Bearer <value>" header to /api/telegram/cron
# Set this in Vercel dashboard → Settings → Environment Variables
CRON_SECRET=

# -----------------------------------------------------------------------------
# Firebase Admin SDK — SECRET (server-side only)
# -----------------------------------------------------------------------------

# Service account JSON as a base64-encoded string OR raw JSON string.
# Obtain from Firebase console → Project Settings → Service accounts → Generate new private key
# Encode: base64 -i serviceAccountKey.json | tr -d '\n'
FIREBASE_SERVICE_ACCOUNT=
